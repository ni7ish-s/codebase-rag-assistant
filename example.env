# Codebase RAG Assistant configuration.
# Copy this to .env and adjust as needed.

# --- Embedding backend (local, no API key) ---
REPORAG_PROVIDER=sentence-transformers
REPORAG_MODEL=all-MiniLM-L6-v2

# --- Locations ---
# The codebase to index/search.
REPORAG_WATCHED_DIR=/path/to/your/codebase
# Where the ChromaDB store is kept.
REPORAG_STORE_DIR=./chroma_db

# --- Retrieval ---
REPORAG_TOP_K=8

# --- LLM answers (Ollama, local, no API key) ---
# Ollama's OpenAI-compatible endpoint.
OPENAI_BASE_URL=http://localhost:11434/v1
REPORAG_CHAT_MODEL=qwen2.5-coder:7b

# Max tokens generated per answer.
REPORAG_ANSWER_MAX_TOKENS=1024
