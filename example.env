# Codebase RAG Assistant configuration.
# Copy this to .env and adjust as needed.

# --- Embedding backend (local, no API key) ---
CODERAG_PROVIDER=sentence-transformers
CODERAG_MODEL=all-MiniLM-L6-v2

# --- Locations ---
# The codebase to index/search.
CODERAG_WATCHED_DIR=/path/to/your/codebase
# Where the ChromaDB store is kept.
CODERAG_STORE_DIR=./chroma_db

# --- Retrieval ---
CODERAG_TOP_K=8

# --- LLM answers (Ollama, local, no API key) ---
# Codebase RAG Assistant configuration.
# Copy this to .env and adjust as needed.

# --- Embedding backend (local, no API key) ---
CODERAG_PROVIDER=sentence-transformers
CODERAG_MODEL=all-MiniLM-L6-v2

# --- Locations ---
# The codebase to index/search.
CODERAG_WATCHED_DIR=/path/to/your/codebase
# Where the ChromaDB store is kept.
CODERAG_STORE_DIR=./chroma_db

# --- Retrieval ---
CODERAG_TOP_K=8

# --- LLM answers (Ollama, local, no API key) ---
# Ollama's OpenAI-compatible endpoint.
OPENAI_BASE_URL=http://localhost:11434/v1
CODERAG_CHAT_MODEL=llama3.1

# Max tokens generated per answer.
CODERAG_ANSWER_MAX_TOKENS=1024